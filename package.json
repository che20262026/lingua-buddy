{
  "name": "lingua-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LinguaBuddy 语伴英语 - AI 角色扮演式英语学习 Agent 应用",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:server": "tsx server.ts",
    "dev:server:mock": "tsx server.ts --mock",
    "dev:full": "concurrently -n server,vite -c cyan,magenta \"npm:dev:server\" \"npm:dev\"",
    "dev:mock": "concurrently -n server,vite -c cyan,magenta \"npm:dev:server:mock\" \"npm:dev\"",
    "dev:ai": "node scripts/llm-dev-server.mjs --with-vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate-icons": "node scripts/generate-pwa-icons.mjs",
    "smoke": "node smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2"
  }
}
