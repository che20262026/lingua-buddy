# LinguaBuddy 环境变量模板（复制为 .env.local 后填入自己的值；.env.local 不要提交）
# v2.8：新增内置录音转写（ASR）端点与独立限流额度；4 个函数桶互相隔离。
# 注意：只有 VITE_ 前缀的变量会被 Vite 注入前端 bundle；其余变量仅服务端可读。

# ─────────────────────────────────────────────────────────────
# 一、Supabase 云同步（前端可读，anon key 受 RLS 约束）
# Supabase 控制台 → Project Settings → API
# ─────────────────────────────────────────────────────────────
# Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# anon / public key —— 只能用这一把，它受 RLS 约束
# 切勿填写 service_role key：它会绕过 RLS，且一旦进前端就等于公开
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────
# 二、真实 AI 对话 + AI 发音评测 + 大肥鱼自由对话 + 录音转写（Serverless 函数，仅服务端读取）
# ⚠️ 绝对不要改成 VITE_LLM_API_KEY：Vite 会把值打进浏览器 bundle，
#    等于把密钥公开。本组变量由 netlify/functions/chat.ts（对话）、
#    netlify/functions/evaluate.ts（发音评测）、
#    netlify/functions/freetalk.ts（大肥鱼自由对话）与
#    netlify/functions/transcribe.ts（录音转写）用 process.env 读取。
#    四个函数共用同一把密钥，但限流桶互相独立（见第三节）。
# 纯本地联调：npm run dev:full（读本文件真实 Key）/ npm run dev:mock（内置假上游，零真 Key）
# 生产部署：Netlify → Site settings → Environment variables 里配置下面这些变量
# ─────────────────────────────────────────────────────────────

# 大模型密钥（DeepSeek / Kimi / OpenAI 等 OpenAI 兼容服务）
LLM_API_KEY=sk-your-llm-api-key

# 接口地址：填到 /v1 这一层即可，函数会自动补 /chat/completions
#   DeepSeek : https://api.deepseek.com/v1
#   Kimi     : https://api.moonshot.cn/v1
#   OpenAI   : https://api.openai.com/v1
# 也可直接填完整的 .../chat/completions
LLM_API_BASE=https://api.deepseek.com/v1

# 模型名（选填，默认 deepseek-chat；用 Kimi 改成 moonshot-v1-8k）
LLM_MODEL=deepseek-chat

# 录音转写（Android 语音输入兜底，服务端持密钥，前端零配置）
# 默认端点 = LLM_API_BASE + /tools/asr（DeepSeek 官方 ASR，支持中英混说）；
# 只接受 16-bit PCM WAV / Ogg Opus，≤8MiB、≤120 秒，前端会先把 webm 转成 WAV。
# 若改用 OpenAI 兼容 /audio/transcriptions，可填完整 URL 覆盖（留空即用默认值）。
LLM_ASR_URL=

# 上游请求超时：api/chat.ts（legacy Vercel 入口）15 秒；
# netlify/functions/chat.ts 为 9 秒（Netlify 同步函数默认约 10s 上限，留 1s 余量）。
# 超时 / 报错都会返回 fallback:true，前端自动回退本地 Mock 演示。
#
# ── 纯本地联调（不需要任何云 CLI / 登录）──────────────────────────
# 后端 server.ts 跑在 http://localhost:3001，vite.config.ts 的 server.proxy
# 把前端所有 /.netlify/functions 与 /api 请求转发过去（保留前缀，路径与线上一致）。
#   npm run dev:full     → concurrently 同时起 Express(3001) + Vite(5173)，读本文件的真实 Key
#   npm run dev:mock     → 同上，但启用内置假上游：零真 Key / 零外网也能跑通 GET/POST/SSE 全链路
#   npm run dev:server   → 只起后端 3001，另开终端跑 npm run dev
#   npm run dev:server:mock → 只起后端（假上游模式）
# 生产环境由 Netlify 的 netlify/functions/chat.ts 响应，此代理配置不生效。

# ─────────────────────────────────────────────────────────────
# 三、防刷限流（仅服务端读取）
# 纯内存 IP 限流：每个 IP 默认每分钟 5 次、每天 50 次。
# 只统计 POST（真正消耗大模型额度的生成请求）；GET 能力探测不消耗配额。
# 设为 0 表示关闭该维度（例如本地调试想放开）。
# ⚠️ Serverless 实例级内存近似限流：挡得住随手刷屏与失控重试，
#    挡不住有组织的分布式攻击——需要更强时换成 Redis / Upstash 之类的共享存储。
#
# 四个函数分桶计数**互相独立**，额度变量也分两组：
#   对话桶   = 裸 IP                 （RATE_LIMIT_*，默认 5/分、50/天）
#   评测桶   = "eval:" + IP          （RATE_LIMIT_*，默认 5/分、50/天）
#   鱼塘桶   = "freetalk:" + IP      （FREETALK_*，默认 8/分、50/天）
#   转写桶   = "asr:" + IP           （ASR_*，默认 6/分、50/天）
# 所以练发音、聊天、跟鱼说话、录音转写互不抢额度。本地 Express 联调台
# （server.ts）在同一进程里加载四个函数、共用同一份限流表，
# 正是靠这些前缀把它们隔开。
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50

# 大肥鱼自由对话专用额度（仅服务端读取；0 表示关闭该维度）
FREETALK_RATE_LIMIT_PER_MINUTE=8
FREETALK_RATE_LIMIT_PER_DAY=50

# 录音转写专用额度（仅服务端读取；0 表示关闭该维度）
# 转写比对话贵，默认给得保守些；429 返回中文提示 + Retry-After，
# 前端据此提示「稍等或直接打字」，不会打断对话。
ASR_RATE_LIMIT_PER_MINUTE=6
ASR_RATE_LIMIT_PER_DAY=50
